# --- OANDA v20 API Configuration ---
OANDA_ACCESS_TOKEN=your_oanda_v20_personal_access_token
OANDA_ACCOUNT_ID=101-001-12345678-001
# Options: "practice" or "live"
OANDA_ENVIRONMENT=practice

# --- LLM & News API Configuration ---
LLM_API_KEY=sk-your-openai-or-gemini-compatible-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
NEWS_API_KEY=your_finnhub_or_newsapi_key

# --- Notifications (Discord & SMTP Email) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alert_email@gmail.com
SMTP_PASS=your_app_specific_password
ALERT_RECIPIENT_EMAIL=trader@yourdomain.com

# --- Strategy & Risk Parameters ---
WATCHLIST=EUR_USD,GBP_USD,USD_JPY
RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.03
POLLING_INTERVAL_SECONDS=60
MIN_SENTIMENT_THRESHOLD=0.30
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=2.5

# --- Dashboard Login ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-strong-password
SESSION_TTL_HOURS=12
# Set to true when serving the dashboard over HTTPS
COOKIE_SECURE=false

# --- Docker Compose: Postgres (LLM result cache) & Cloudflare Tunnel ---
POSTGRES_USER=oanda
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=oanda_agent
LLM_CACHE_TTL_MINUTES=30
# Zero Trust dashboard > Networks > Tunnels > Create tunnel (Cloudflared) > copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# --- Execution & Trade Management ---
MAX_OPEN_TRADES=3
# Skip entries when spread > this fraction of M15 ATR
MAX_SPREAD_ATR_RATIO=0.30
# Max share of free margin a single new trade may use
MAX_MARGIN_USAGE_PCT=0.5
# Move SL to break-even (+ lock-in) once profit reaches this many R (0 disables)
BREAKEVEN_TRIGGER_R=1.0
BREAKEVEN_LOCK_R=0.1

# --- Strategy Engine ---
# rules = technicals + sentiment | ai_shadow = AI trader decides & is journaled, never trades | ai = AI trader trades
STRATEGY_MODE=rules
# AI_TRADER_MODEL=gpt-4.1   (defaults to LLM_MODEL)
AI_MIN_CONFIDENCE=0.65
# Entry, confirmation, trend timeframes
STRATEGY_TIMEFRAMES=M15,H1,H4
DAILY_SUMMARY_ENABLED=true
